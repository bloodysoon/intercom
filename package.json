{
  "name": "intercom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "next build",
    "start": "NODE_ENV=production node server/index.mjs",
    "start:next": "next start",
    "relay": "node server/relay-standalone.mjs",
    "cert": "node scripts/make-cert.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "mqtt": "^5.16.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
